# ---------------------------------------------------------------------------
# Sendox — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENV=development
LOG_LEVEL=INFO

# --- Core services (defaults match docker-compose.yml) ---------------------
DATABASE_URL=postgresql+psycopg://sendox:sendox@localhost:5432/sendox
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
MJML_URL=http://localhost:7070

# --- API <-> web -----------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Auth (phase 0.3) ------------------------------------------------------
# Signs the session JWT. Must be at least 32 bytes; the API refuses to start in
# production with a short or default one.
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
SESSION_COOKIE_NAME=sendox_session

# --- Anthropic (phase 0.5) -------------------------------------------------
# A Console-issued key (sk-ant-api03-...) is scoped to a workspace and needs
# nothing else. An unscoped user key (sk-ant-usr-...) also requires
# ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (local, no vendor) ----------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Mail. Mailpit locally (Docker stack); Amazon SES in production ------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=Sendox <no-reply@sendox.local>

# --- Shopify (phase 1.2) ---------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,read_checkouts
SHOPIFY_WEBHOOK_SECRET=

# --- AWS / SES (phase 1.10) -----------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
S3_BUCKET=

# --- Stripe (phase 4.1) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
