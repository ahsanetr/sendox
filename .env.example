# ---------------------------------------------------------------------------
# Sendox — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENV=development
LOG_LEVEL=INFO

# --- Core services (defaults match docker-compose.yml) ---------------------
DATABASE_URL=postgresql+psycopg://sendox:sendox@localhost:5432/sendox
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
MJML_URL=http://localhost:7070

# --- API <-> web -----------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Auth (phase 0.3) ------------------------------------------------------
# Shared secret: NextAuth signs the JWT, FastAPI verifies it.
# Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-change-me
NEXTAUTH_SECRET=dev-only-change-me
NEXTAUTH_URL=http://localhost:3000

# --- Anthropic (phase 0.5) -------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (local, no vendor) ----------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Local mail capture (Mailpit) -----------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Shopify (phase 1.2) ---------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,read_checkouts
SHOPIFY_WEBHOOK_SECRET=

# --- AWS / SES (phase 1.10) -----------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
S3_BUCKET=

# --- Stripe (phase 4.1) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
